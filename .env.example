# Environment Configuration for Hermes Virtual Office
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/office.sqlite

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
OWNER_TELEGRAM_IDS=123456789,987654321
OWNER_EMAILS=dhiko.h@gmail.com
APP_URL=https://t.me/hermes_office_bot/app

# Hermes Gateway Settings (mock | real)
# PRODUCTION (Coolify): HERMES_MODE=real and HERMES_BASE_URL must be the Docker
# network gateway of the Coolify network (find it: docker network inspect coolify),
# e.g. http://172.16.1.1:8642. host.docker.internal and 127.0.0.1 DO NOT work there:
# Coolify's Dockerfile build pack ignores docker-compose.yml, so extra_hosts is absent,
# and the server refuses to start in production with a localhost base URL.
HERMES_MODE=mock
HERMES_BASE_URL=http://127.0.0.1:8642
# MUST equal API_SERVER_KEY in ~/.hermes/.env on the VPS host.
# Placeholder values (mock-secret-key, hermes_secret_token, ...) are rejected in production.
HERMES_KEY_DEFAULT=mock-secret-key
HERMES_TIMEOUT_MS=30000

# Media chat & retensi (Tahap 12)
# MEDIA_DIR kosong = <direktori DB>/media, jadi di kontainer cukup set DB_PATH.
# Retensi: gambar chat 7 hari, artefak agent 30 hari, total dibatasi MEDIA_CAP_MB
# (yang paling tua dihapus lebih dulu). 0 = retensi/cap dimatikan.
MEDIA_DIR=
MEDIA_IMAGE_RETENTION_DAYS=7
MEDIA_ARTIFACT_RETENTION_DAYS=30
MEDIA_CAP_MB=500
MEDIA_UPLOAD_MAX_MB=8
MEDIA_SWEEP_INTERVAL_MIN=60
MEDIA_SWEEP_DISABLED=0

# On the VPS host, the API server must be enabled or every task fails:
#   API_SERVER_ENABLED=true
#   API_SERVER_KEY=<same value as HERMES_KEY_DEFAULT>
#   API_SERVER_HOST=172.16.1.1   # Docker network gateway, never 0.0.0.0
#   API_SERVER_PORT=8642

# Agent-specific secret API keys (Rule S4: Isolated on server)
# Format: HERMES_KEY_<AGENT_ID>=secret_token
# HERMES_KEY_AGENT_FINANCE_01=hermes_sec_fin_token
# HERMES_KEY_AGENT_SOCIAL_01=hermes_sec_soc_token

# Security & Development Flags
# DEV_AUTH_BYPASS is strictly prohibited in production mode (Server will refuse to start per Rule S3)
DEV_AUTH_BYPASS=0
